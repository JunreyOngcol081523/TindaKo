<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             x:Class="TindaKo.Views.BuyerPage"
             x:DataType="viewmodel:BuyerViewModel"
             Title="Select Buyer"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <ContentPage.BindingContext>
        <viewmodel:BuyerViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="CardLight">#FFFFFF</Color>
            <Color x:Key="CardDark">#1E1E1E</Color>
            <Color x:Key="AccentColor">#2E7D32</Color>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
                <Setter Property="Stroke"
                        Value="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
            </Style>

            <Style x:Key="SubText" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#616161, Dark=#B0B0B0}" />
            </Style>

            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                <Setter Property="PlaceholderColor" Value="#9E9E9E" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Rows: add form | search | list (fills space) | pinned action bar -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Padding="16,16,16,0">

        <!-- ADD NEW BUYER -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Kung wala pa sa listahan" Style="{StaticResource SubText}" />
                <Label Text="E-rehistro ang uutang" Style="{StaticResource SectionTitle}" />

                <Entry Placeholder="Pangalan"
                       Text="{Binding NewBuyerName}"
                       Style="{StaticResource FieldEntry}" />
                <Entry Placeholder="Contact Number"
                       Text="{Binding NewBuyerContact}"
                       Keyboard="Telephone"
                       Style="{StaticResource FieldEntry}" />
                <Entry Placeholder="Address"
                       Text="{Binding NewBuyerAddress}"
                       Style="{StaticResource FieldEntry}" />

                <Button Text="+ Add Buyer"
                        Command="{Binding AddBuyerCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,6,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- SEARCH -->
        <SearchBar Grid.Row="1"
                   Text="{Binding SearchText}"
                   Placeholder="Hanapin ang Pangalan" />

        <!-- BUYER LIST (own scrolling, virtualized) -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Buyers}"
                        SelectionMode="None">

            <CollectionView.Header>
                <Label Text="Sino ang Uutang"
                       Style="{StaticResource SectionTitle}"
                       Margin="4,0,0,8" />
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Walang nahanap na buyer."
                       Style="{StaticResource SubText}"
                       HorizontalOptions="Center"
                       Margin="0,30,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <!-- Avatar -->
                            <Border Grid.Column="0"
                                    WidthRequest="44" HeightRequest="44"
                                    StrokeShape="RoundRectangle 22"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource AccentColor}"
                                    VerticalOptions="Center">
                                <Label Text="👤" FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Details -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="16" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                <Label Text="{Binding ContactNumber}" Style="{StaticResource SubText}" />
                                <Label Text="{Binding Address}"
                                       Style="{StaticResource SubText}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Select -->
                            <Button Grid.Column="2"
                                    Text="Piliin"
                                    VerticalOptions="Center"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    Padding="18,0"
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource AccentColor}"
                                    BorderWidth="1.5"
                                    TextColor="{StaticResource AccentColor}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:BuyerViewModel}}, Path=SelectBuyerCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- PINNED ACTION BAR -->
        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                StrokeShape="RoundRectangle 18,18,0,0"
                Margin="-16,0,-16,0"
                Padding="16,12,16,16">
            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Napiling uutang" Style="{StaticResource SubText}" />
                    <Label Text="{Binding SelectedBuyerName}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,2*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            CornerRadius="12" HeightRequest="48"
                            TextColor="White"
                            BackgroundColor="{StaticResource CancelButton}"
                            Command="{Binding CloseBuyerCommand}" />
                    <Button Grid.Column="1"
                            Text="Select this Buyer"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmSelectionCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>