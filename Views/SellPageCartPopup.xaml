<?xml version="1.0" encoding="utf-8" ?>
<sfPopup:SfPopup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Toolkit.Popup;assembly=Syncfusion.Maui.Toolkit"
                 xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
                 xmlns:model="clr-namespace:TindaKo.Models"
                 x:Class="TindaKo.Views.SellPageCartPopup"
                 x:Name="SellPageCartSfPopup"
                 AutoSizeMode="Height"
                 ShowCloseButton="True"
                 HeaderHeight="60">

    <sfPopup:SfPopup.PopupStyle>
        <sfPopup:PopupStyle CornerRadius="18"
                            PopupBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            HeaderBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" />
    </sfPopup:SfPopup.PopupStyle>

    <!-- HEADER -->
    <sfPopup:SfPopup.HeaderTemplate>
        <DataTemplate>
            <HorizontalStackLayout HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="10">
                <Image Source="shoppingbasket.png"
                       HeightRequest="30"
                       WidthRequest="30"
                       VerticalOptions="Center" />
                <Label Text="Cart Preview"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{StaticResource PrimaryDark}" />
            </HorizontalStackLayout>
        </DataTemplate>
    </sfPopup:SfPopup.HeaderTemplate>

    <!-- CONTENT -->
    <sfPopup:SfPopup.ContentTemplate>
        <DataTemplate>
            <Grid RowDefinitions="Auto,Auto" RowSpacing="0">

                <!-- Items: capped height so the popup never outgrows the screen -->
                <ScrollView Grid.Row="0" MaximumHeightRequest="380">
                    <VerticalStackLayout Spacing="8"
                                         Padding="14,4,14,12"
                                         BindableLayout.ItemsSource="{Binding CartList}">

                        <BindableLayout.EmptyView>
                            <Label Text="Walang laman ang cart."
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   Margin="0,30"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#A0A0A0}" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:CartItems">
                                <Border Padding="12"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Gray300}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#262626}">

                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="10"
                                          RowSpacing="2">

                                        <!-- Name + category -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ProdName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding ProdCategory}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#A0A0A0}" />

                                        <!-- Subtotal -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat='₱{0:N2}'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End"
                                               TextColor="#004D40" />

                                        <!-- Qty x Price -->
                                        <Label Grid.Row="2" Grid.Column="0"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource Gray600}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Quantity}" FontAttributes="Bold" />
                                                    <Span Text=" × " />
                                                    <Span Text="{Binding Price, StringFormat='₱{0:N2}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Remove -->
                                        <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                                                Text="Remove"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                HeightRequest="34"
                                                Padding="12,0"
                                                CornerRadius="17"
                                                VerticalOptions="End"
                                                HorizontalOptions="End"
                                                BackgroundColor="Transparent"
                                                BorderWidth="1"
                                                BorderColor="{StaticResource CancelButton}"
                                                TextColor="{StaticResource CancelButton}"
                                                Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference SellPageCartSfPopup}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- TOTAL (always visible, outside the scroll area) -->
                <Border Grid.Row="1"
                        Padding="20,14"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource PrimaryDark}"
                        StrokeShape="RoundRectangle 0,0,18,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Total"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextColor="{StaticResource WhiteText}" />
                        <Label Grid.Column="1"
                               Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource WhiteText}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </sfPopup:SfPopup.ContentTemplate>
</sfPopup:SfPopup>