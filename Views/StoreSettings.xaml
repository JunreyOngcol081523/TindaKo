<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.StoreSettings"
             xmlns:viewmodels="clr-namespace:TindaKo.ViewModel"
             Title="Store Settings">
    <ScrollView>
        <Border Style="{StaticResource CardStyle}" Margin="20">
            <VerticalStackLayout Spacing="10" Margin="10">

                <!-- Header -->
                <Label 
                Text="Store Settings"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

                <!-- Store Name Section -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                    Text="Store Name"
                    FontSize="16"
                    FontAttributes="Bold" />
                    <Entry 
                    Placeholder="Enter your store name"
                    Text="{Binding StoreName}"
                    />
                </VerticalStackLayout>

                <!-- Address Section -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                    Text="Store Address"
                    FontSize="16"
                    FontAttributes="Bold" />
                    <Entry 
                    Placeholder="Enter your complete store address"
                    Text="{Binding StoreAddress}"
                    />
                </VerticalStackLayout>

                <!-- email Section -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                    Text="Store Email"
                    FontSize="16"
                    FontAttributes="Bold" />
                    <Entry 
                    Placeholder="Enter your store email"
                    Text="{Binding StoreEmail}"
                    Keyboard="Email"/>
                </VerticalStackLayout>

                <!-- phone number Section -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                    Text="Store Phone Number"
                    FontSize="16"
                    FontAttributes="Bold" />
                    <Entry 
                    Placeholder="Enter your Store Phone Number"
                    Text="{Binding StorePhoneNum}"
                    Keyboard="Email"/>
                </VerticalStackLayout>

                <!-- Buttons Section -->
                <VerticalStackLayout Spacing="12" Margin="0,20,0,0">
                    <Button 
                    x:Name="SaveButton"
                    Text="Save Settings"
                    CornerRadius="8"
                    HeightRequest="50"
                    Command="{Binding SaveStoreSettingsCommand}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>