<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Toolkit.NumericUpDown;assembly=Syncfusion.Maui.Toolkit"
             x:Class="TindaKo.Views.StoreSettings"
             Title="Store Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Store information -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Store Information" FontSize="18" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Store Name" FontAttributes="Bold" />
                        <Entry Placeholder="Enter your store name"
                               Text="{Binding StoreName}"
                               MaxLength="60"
                               ReturnType="Next" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Store Address" FontAttributes="Bold" />
                        <Entry Placeholder="Enter your complete store address"
                               Text="{Binding StoreAddress}"
                               MaxLength="120"
                               ReturnType="Next" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Store Email" FontAttributes="Bold" />
                        <Entry Placeholder="Enter your store email"
                               Text="{Binding StoreEmail}"
                               Keyboard="Email"
                               MaxLength="80"
                               ReturnType="Next" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Store Phone Number" FontAttributes="Bold" />
                        <!-- BUG FIX: was Keyboard="Email" -->
                        <Entry Placeholder="Enter your store phone number"
                               Text="{Binding StorePhoneNum}"
                               Keyboard="Telephone"
                               MaxLength="20"
                               ReturnType="Done" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Utang -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Utang" FontSize="18" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Allow utang in your store" VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding AllowUtang}"
                                SemanticProperties.Description="Allow utang in your store" />
                    </Grid>

                    <!-- Only relevant when utang is allowed -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding AllowUtang}">
                        <Label Text="Days before due date" FontAttributes="Bold" />
                        <Label Text="Default number of days given to pay an utang."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        <editors:SfNumericUpDown Value="{Binding DueDateDays, Mode=TwoWay}"
                                                 AllowNull="False"
                                                 Minimum="0"
                                                 Maximum="365"
                                                 CustomFormat="0"
                                                 SmallChange="1"
                                                 UpDownButtonColor="{StaticResource PrimaryDark}"
                                                 UpDownButtonAlignment="Both"
                                                 HorizontalTextAlignment="Center"
                                                 HeightRequest="45" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save Settings"
                    CornerRadius="8"
                    HeightRequest="50"
                    Command="{Binding SaveStoreSettingsCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
