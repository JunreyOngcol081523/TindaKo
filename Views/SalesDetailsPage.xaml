<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.SalesDetailsPage"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             Title="Sales Details">

    <VerticalStackLayout Padding="20" Spacing="10">

        <!-- First Row -->
        <Grid ColumnDefinitions="*,Auto" >
            <Label Text="{Binding TransDisplay.DateTimeTransacted}"
                   FontSize="12"
                   TextColor="Black"
                   FontAttributes="Italic"/>
            <Label Text="{Binding TransDisplay.Username}"
                   FontSize="12"
                   HorizontalOptions="End"
                   TextColor="Black"/>
        </Grid>

        <!-- Second Row -->
        <Grid ColumnDefinitions="*,Auto"
              RowDefinitions="*,*">
            <Label Grid.Row="0" 
                   Grid.Column="0" 
                   Grid.RowSpan="2"
                   VerticalOptions="Center"
                   Text="{Binding TransDisplay.TotalAmount, StringFormat='₱{0:N2}'}"

                   FontAttributes="Bold"
                   TextColor="#004D40"/>
            <Label Grid.Row="0" 
                   Grid.Column="1" 
                   Text="{Binding TransDisplay.TransactionType}"

                   HorizontalOptions="End"
                   FontAttributes="Bold"
                   TextColor="#16A085"/>
            <!-- Third Row -->
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                Text="{Binding TransDisplay.BuyerName}"
               FontSize="16"
               TextColor="#34495E"
               HorizontalOptions="End"
               HorizontalTextAlignment="End"/>
        </Grid>



        <!-- Separator -->
        <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

        <CollectionView ItemsSource="{Binding SoldItems}">
            <CollectionView.Header>
                <Grid ColumnDefinitions="2.5*,2*,1.5*,1*,2*" Padding="5" BackgroundColor="{StaticResource Primary}">
                    <Label TextColor="{StaticResource WhiteText}" Grid.Column="0" Text="Product Name" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource WhiteText}" Grid.Column="1" Text="Category" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource WhiteText}" Grid.Column="2" Text="Price" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource WhiteText}" Grid.Column="3" Text="Qty" FontAttributes="Bold" />
                    <Label TextColor="{StaticResource WhiteText}" Grid.Column="4" Text="Subtotal" FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2.5*,2*,1.5*,1*,2*" Padding="5" RowDefinitions="Auto,*">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding ProductName}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Category}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Price, StringFormat='₱{0:N2}'}" />
                        <Label Grid.Row="0" Grid.Column="3" Text="{Binding Qty}" />
                        <Label Grid.Row="0" Grid.Column="4" Text="{Binding SoldSubtotal, StringFormat='₱{0:N2}'}" />
                        <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" HeightRequest="1" Color="LightGray" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Close" Command="{Binding CloseDetailsCommand}" BackgroundColor="{StaticResource CancelButton}"/>
    </VerticalStackLayout>
</ContentPage>
