<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.ProductPage"
             xmlns:vm="clr-namespace:TindaKo.ViewModel"
             Title="Products"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#757575, Dark=#A0A0A0}" />
            </Style>

            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                <Setter Property="PlaceholderColor" Value="#9E9E9E" />
            </Style>

            <Style x:Key="StatChip" TargetType="Border">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=#F0F2F4, Dark=#2A2A2A}" />
            </Style>

            <Style x:Key="StatValue" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
            </Style>

            <Style x:Key="FilledButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{StaticResource PrimaryDark}" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Rows: header + form | search + filter | product list (fills space) -->
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <!-- ROW 0: ACTION BAR + ADD-PRODUCT FORM -->
        <VerticalStackLayout Grid.Row="0" Padding="12,12,12,0" Spacing="10">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="New Product"
                        ImageSource="add.png"
                        ContentLayout="Left,8"
                        Style="{StaticResource FilledButton}"
                        Command="{Binding AddNewProductCommand}" />
                <Button Grid.Column="1"
                        Text="Close"
                        ImageSource="close.png"
                        ContentLayout="Left,8"
                        Style="{StaticResource OutlineButton}"
                        Padding="16,0"
                        IsVisible="{Binding FormVisible}"
                        Command="{Binding CloseProductFormCommand}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}"
                    Padding="16"
                    IsVisible="{Binding FormVisible}">
                <VerticalStackLayout Spacing="10">

                    <VerticalStackLayout Spacing="0">
                        <Label Text="PRODUCT NAME" Style="{StaticResource CaptionLabel}" />
                        <Entry Text="{Binding ProductName}"
                               Placeholder="Product Name"
                               Style="{StaticResource FieldEntry}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="0">
                        <Label Text="CATEGORY" Style="{StaticResource CaptionLabel}" />
                        <Picker SelectedItem="{Binding ProductCategory}"
                                ItemsSource="{Binding Categories}"
                                Title="Select category"
                                FontSize="15"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="PRICE (₱)" Style="{StaticResource CaptionLabel}" />
                            <Entry Text="{Binding ProductPrice}"
                                   Placeholder="0.00"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="QTY IN" Style="{StaticResource CaptionLabel}" />
                            <Entry Text="{Binding StocksIn}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Add Product"
                            ImageSource="add.png"
                            ContentLayout="Left,8"
                            Style="{StaticResource FilledButton}"
                            HeightRequest="50"
                            Margin="0,6,0,0"
                            Command="{Binding AddProductCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- ROW 1: SEARCH + LIMIT / LOAD -->
        <VerticalStackLayout Grid.Row="1" Padding="12,0" Spacing="6">
            <SearchBar Text="{Binding SearchText}"
                       Placeholder="Search product" />

            <Grid ColumnDefinitions="Auto,90,*" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="Limit rows"
                       FontSize="13"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                <Entry Grid.Column="1"
                       Text="{Binding MaxResults}"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       Style="{StaticResource FieldEntry}" />
                <Button Grid.Column="2"
                        Text="Load Products"
                        Style="{StaticResource OutlineButton}"
                        HeightRequest="42"
                        Command="{Binding RefreshProductsCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- ROW 2: PRODUCT LIST -->
        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            Margin="12,0">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Footer>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <Label Text="No products to show."
                           Style="{StaticResource CaptionLabel}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="14,10,14,14">
                            <VerticalStackLayout Spacing="8">

                                <!-- Product name (inline edit) -->
                                <Entry Text="{Binding ProdName, Mode=TwoWay}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource PrimaryDark}"
                                       Placeholder="Product Name" />

                                <!-- Category + price (inline edit) -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="CATEGORY" Style="{StaticResource CaptionLabel}" />
                                        <Entry Text="{Binding Category, Mode=TwoWay}"
                                               Placeholder="Category"
                                               BackgroundColor="Transparent"
                                               Style="{StaticResource FieldEntry}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="PRICE (₱)" Style="{StaticResource CaptionLabel}" />
                                        <Entry Text="{Binding Price, Mode=TwoWay}"
                                               Placeholder="Enter price"
                                               Keyboard="Numeric"
                                               BackgroundColor="Transparent"
                                               Style="{StaticResource FieldEntry}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Stock summary chips -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" Style="{StaticResource StatChip}">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="STOCKS IN" Style="{StaticResource CaptionLabel}" />
                                            <Label Text="{Binding StocksIn}" Style="{StaticResource StatValue}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource StatChip}">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="STOCKS OUT" Style="{StaticResource CaptionLabel}" />
                                            <Label Text="{Binding StocksOut}" Style="{StaticResource StatValue}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Remaining: turns red at 0 -->
                                    <Border Grid.Column="2" Style="{StaticResource StatChip}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding CurrentStock}"
                                                         Value="0">
                                                <Setter Property="BackgroundColor" Value="#1AC0392B" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="REMAINING" Style="{StaticResource CaptionLabel}" />
                                            <Label Text="{Binding CurrentStock}"
                                                   Style="{StaticResource StatValue}"
                                                   TextColor="#004D40">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding CurrentStock}"
                                                                 Value="0">
                                                        <Setter Property="TextColor" Value="#C0392B" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Actions -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                    <Button Grid.Column="0"
                                            Text="Adjust Stock"
                                            ImageSource="squarepen.png"
                                            ContentLayout="Left,8"
                                            FontSize="14"
                                            Style="{StaticResource OutlineButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductViewModel}}, Path=OpenProductStocksAdjustCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1"
                                            Text="Save"
                                            ContentLayout="Left,8"
                                            FontSize="14"
                                            Style="{StaticResource FilledButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductViewModel}}, Path=UpdateProductCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading indicator (overlays the list) -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Color="{StaticResource PrimaryDark}"
                               WidthRequest="50"
                               HeightRequest="50" />
        </Grid>
    </Grid>
</ContentPage>