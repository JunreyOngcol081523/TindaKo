<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.ProductPage"
             xmlns:vm="clr-namespace:TindaKo.ViewModel"
             Title="Products">

    <ContentPage.BindingContext>
        <vm:ProductViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="16" Spacing="10">

        <!-- Search and Add Button -->
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*"  RowSpacing="10">
            <Label Grid.Row="0" Grid.Column="0" Text="Prod Name:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Text="{Binding ProductName}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Placeholder="Product Name"/>
            <Label Grid.Row="1" Grid.Column="0" Text="Category" VerticalOptions="Center"  HorizontalOptions="Center"/>
            <Picker SelectedItem="{Binding ProductCategory}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Categories}"/>
            <Label Grid.Row="2" Grid.Column="0" Text="Price:" VerticalOptions="Center"  HorizontalOptions="Center"/>
            <Entry Text="{Binding ProductPrice}" Grid.Row="2" Grid.Column="1" Placeholder="price" Keyboard="Numeric"/>
            <Label Grid.Row="2" Grid.Column="2" Text="Qty In:" VerticalOptions="Center"  HorizontalOptions="Center"/>
            <Entry Text="{Binding StocksIn}" Grid.Row="2" Grid.Column="3" Keyboard="Numeric"/>
            <Entry Text="{Binding SearchText}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Placeholder="search product"/>
            <Button Command="{Binding AddProductCommand}" Grid.Row="3" Grid.Column="3" ImageSource="add.png" HeightRequest="50" BackgroundColor="Transparent"/>
        </Grid>

        <!-- Table Header -->
        <Grid ColumnDefinitions="2*,1.5*,1*,1*,Auto" Padding="4" BackgroundColor="{StaticResource Gray200}">
            <Label Text="Name" FontAttributes="Bold" />
            <Label Text="Category" FontAttributes="Bold" Grid.Column="1"/>
            <Label Text="Price" FontAttributes="Bold" Grid.Column="2"/>
            <Label Text="Stocks" FontAttributes="Bold" Grid.Column="3"/>
            <Label Text="Action" FontAttributes="Bold" Grid.Column="4"/>
        </Grid>

        <!-- Product List -->
        <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*,1.5*,1*,1*,Auto"
                          Padding="4" Margin="0,2"
                          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray100}}"
                          StyleClass="CardBorderStyle">

                        <Label Text="{Binding ProdName}" />
                        <Label Text="{Binding Category}" Grid.Column="1"/>
                        <Label Text="{Binding Price, StringFormat='₱{0:F2}'}" Grid.Column="2"/>
                        <Label Text="{Binding CurrentStock}" Grid.Column="3"/>
                        <Button ImageSource="pencil.png"
                                HeightRequest="10"
                                Grid.Column="4"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductViewModel}}, Path=EditProductCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Transparent"
                                Padding="2,2"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
