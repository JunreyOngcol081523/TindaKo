<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.UserSettingsPage"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             x:Name="UserSettingsPageRef"
             Title="User Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <HorizontalStackLayout Spacing="8">
                <Button ImageSource="add.png"
                        HeightRequest="50"
                        BackgroundColor="Transparent"
                                Command="{Binding AddNewUserCommand}" />
                <Button ImageSource="close.png"
                        HeightRequest="50"
                        BackgroundColor="Transparent"
                                Command="{Binding CloseUserFormCommand}" />
            </HorizontalStackLayout>
            <!-- Section: Add/Edit User -->
            <Border Style="{StaticResource CardStyle}" Padding="15"  IsVisible="{Binding UserFormVisible}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Add / Edit User" FontAttributes="Bold" FontSize="18" />


                    <Picker 
                        Title="Select Role"
                        ItemsSource="{Binding UserRoles}"
                        SelectedItem="{Binding SelectedUser.UserRole, Mode=TwoWay}" />

                    <Entry Placeholder="Username" Text="{Binding SelectedUser.UserName, Mode=TwoWay}" />
                    <Entry Placeholder="Full Name" Text="{Binding SelectedUser.UserFullName, Mode=TwoWay}" />
                    <Entry Placeholder="Password" Text="{Binding NewUserPassword, Mode=TwoWay}" IsPassword="True" />
                    <Entry Placeholder="Confirm Password" Text="{Binding ConfirmPassword, Mode=TwoWay}" IsPassword="True" />
                    <Button Text="{Binding SaveButtonText}"
                            Command="{Binding SaveUserCommand}" />
                </VerticalStackLayout>
            </Border>


            <!-- Section: Existing Users List -->
            <Label Text="Registered Users" FontSize="18" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Users}"
                EmptyView="No users found.">

                <!-- 👇 Header definition -->
                <CollectionView.Header>
                    <Grid ColumnDefinitions="Auto,*,*,*,*,Auto"
                        Padding="10"
                          ColumnSpacing="10"
                        BackgroundColor="{StaticResource PrimaryDark}">
                        <Label TextColor="{StaticResource WhiteText}" Text="#" FontAttributes="Bold" Grid.Column="0" />
                        <Label TextColor="{StaticResource WhiteText}" Text="Full Name" FontAttributes="Bold" Grid.Column="1" />
                        <Label TextColor="{StaticResource WhiteText}" Text="Role" FontAttributes="Bold" Grid.Column="2" />
                        <Label TextColor="{StaticResource WhiteText}" Text="Username" FontAttributes="Bold" Grid.Column="3" />
                        <Label TextColor="{StaticResource WhiteText}" Text="Password" FontAttributes="Bold" Grid.Column="4" />
                        <Label TextColor="{StaticResource WhiteText}" Text="Action" FontAttributes="Bold" Grid.Column="5" />
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,*,*,*,Auto"
                                  RowDefinitions="Auto"
                                  ColumnSpacing="10">
                                <Label Text="{Binding Id}" Grid.Column="0" VerticalOptions="Center"/>
                                <Label Text="{Binding UserFullName}" Grid.Column="1" VerticalOptions="Center" />
                                <Label Text="{Binding UserRole}" Grid.Column="2" VerticalOptions="Center" />
                                <Label Text="{Binding UserName}" Grid.Column="3" VerticalOptions="Center" />
                                <Label Text="{Binding UserPassword}" Grid.Column="4" VerticalOptions="Center" />
                                <Button Text="Edit"
                                        Grid.Column="5"
                                        Command="{Binding BindingContext.EditNewUserCommand, Source={x:Reference UserSettingsPageRef}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
