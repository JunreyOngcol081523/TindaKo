<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.SellPage"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             Title="Benta"
             xmlns:model="clr-namespace:TindaKo.Models"
             x:Name="SellPageRoot">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Bar: Search + Cart -->
        <Grid Grid.Row="0" 
              Padding="10" 
              ColumnSpacing="10" 
              ColumnDefinitions="*, Auto">

            <Grid Grid.Column="0">
                <SearchBar Placeholder="Search product"
                    Text="{Binding SearchText}"
                    Grid.Column="0"
                    VerticalOptions="Center" />

            </Grid>
            <!-- Cart Icon + Badge -->
            <Border Grid.Column="1"
                    Padding="5"
                    HorizontalOptions="End"
                    Stroke="Transparent">

                <Grid>
                    <Image Source="shoppingbasket.png"
                           HeightRequest="40"
                           WidthRequest="40"
                           VerticalOptions="Center" />

                    <Border 
                        BackgroundColor="{StaticResource PrimaryDark}" 
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        IsVisible="{Binding CartCount, Converter={StaticResource GreaterThanZeroConverter}}">

                        <Label Text="{Binding CartCount}"
                               TextColor="{StaticResource WhiteText}"
                               FontSize="12"
                               Padding="5"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                    </Border>

                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                                Command="{Binding OpenCartCommand}"/>
                </Border.GestureRecognizers>
            </Border>
        </Grid>
        <!--product list-->
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding ProductList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Product">
                        <Border Margin="10" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding ProdName}" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}"
                                       BackgroundColor="Transparent"/>
                                <Grid ColumnDefinitions="*,*,Auto" 
                                      VerticalOptions="Center" 
                                      ColumnSpacing="5">
                                    <!-- Supplier Price -->
                                    <Label Grid.Column="0" 
                                           HeightRequest="50"
                                           Text="{Binding Price, StringFormat='Price: ₱{0:N}'}"
                                           BackgroundColor="Transparent"/>
                                    <!-- New Stocks Qty -->
                                    <inputLayout:SfTextInputLayout Hint="Quantity"
                                                                   HelperText="Ilan ang bibilhin mo?"
                                                                   HeightRequest="70"
                                                               Grid.Column="1"
                                                               ContainerBackground="Transparent">
                                        <Entry Keyboard="Numeric" Text="{Binding Quantity}"/>
                                    </inputLayout:SfTextInputLayout >

                                    <!-- Add Button -->
                                    <Button 
                                        Grid.Column="2"
                                        ImageSource="add.png"
                                        BackgroundColor="Transparent"
                                        HeightRequest="50"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SellViewModel}}, Path=AddToCartCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid>

                                <Label Text="{Binding Subtotal, StringFormat='Subtotal: ₱{0:N}'}" 
                                       FontSize="12" 
                                       TextColor="Gray"
                                       BackgroundColor="Transparent"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- TRANSACTION & PAYMENT SECTION -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,50" Padding="10" BackgroundColor="Bisque">

            <!-- Payment Method + Total Row -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,45,*,Auto" ColumnSpacing="5">
                <!-- Radio Buttons -->
                <RadioButton Grid.Column="0" Content="Cash" IsChecked="{Binding IsCashChecked}" GroupName="transaction"/>
                <RadioButton Grid.Column="1" Content="Utang" IsChecked="{Binding IsCreditChecked}" GroupName="transaction"/>

                <!-- Spacer -->
                <!-- Grid.Column="3" just eats space to push the total to the right -->

                <!-- Total Amount -->
                <HorizontalStackLayout Grid.Column="4" HorizontalOptions="End" Spacing="3">
                    <Label Text="Total:" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}" 
                   FontAttributes="Bold" TextColor="DarkGreen"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- Pangalan ng umutang -->
            <HorizontalStackLayout Grid.Row="1" Spacing="5">
                <Label Text="{Binding SelectedBuyerName, StringFormat='Name of Creditor: {0}'}"
                       FontAttributes="Bold"
                       TextDecorations="Underline"
                       TextColor="Blue"
                       IsVisible="{Binding IsCreditChecked}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenBuyerModalCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>

            <!-- Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="2" BackgroundColor="AliceBlue">
                <!-- Complete Transaction -->
                <Grid Grid.Column="0" IsEnabled="{Binding IsCartHasItems}" BackgroundColor="{StaticResource Primary}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CompleteTransactionCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Complete Transaction" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                </Grid>

                <!-- Cancel Transaction -->
                <Grid Grid.Column="1" BackgroundColor="{StaticResource CancelButton}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSellCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Cancel Transaction" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
