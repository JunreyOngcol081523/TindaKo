<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.ProductSettingsPage"
             Title="Product Settings">

    <Grid>
        <!-- Content (now scrollable) -->
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Style="{StaticResource CardStyle}" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Import Products" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Para sa mabilis na paglipat ng produkto, punan ang na-download na template." />
                        <Button Text="I-download ang Template"
                                ImageSource="download.png"
                                Command="{Binding DownloadTemplateCommand}" />
                        <Button Text="Import Spreadsheet Template"
                                ImageSource="upload.png"
                                Command="{Binding ImportTemplateCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Real loading overlay: last child = on top, so it also blocks taps while busy -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
