<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TindaKo.Views.CreditorPage"
    xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
    xmlns:converters="clr-namespace:TindaKo.Converters"
    xmlns:segmentedControl="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"

    Title="Listahan ng Utang"
    BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <!-- The ViewModel is created in CreditorPage.xaml.cs (it needs the initial segment).
         The old XAML BindingContext made a second, unused ViewModel on every open. -->

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#757575, Dark=#A0A0A0}" />
            </Style>

            <Style x:Key="FilledButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

            <Style x:Key="SmallOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Rows: filters + totals | creditor list (fills space) -->
    <Grid RowDefinitions="Auto,*" RowSpacing="8">

        <!-- ROW 0: FILTER, TOTAL, SEARCH -->
        <VerticalStackLayout Grid.Row="0" Padding="12,12,12,0" Spacing="10">

            <segmentedControl:SfSegmentedControl
                ItemsSource="{Binding SegmentOptions}"
                SelectedIndex="{Binding SelectedSegmentIndex, Mode=TwoWay}"
                SegmentHeight="42" />

            <!-- Total banner: balance still owed (or total settled on the Paid tab) -->
            <Border BackgroundColor="{StaticResource PrimaryDark}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding TotalLabel}"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{StaticResource WhiteText}" />
                    <Label Grid.Column="1"
                           Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource WhiteText}" />
                </Grid>
            </Border>

            <SearchBar Placeholder="Search creditor..."
                       Text="{Binding SearchText}" />
        </VerticalStackLayout>

        <!-- ROW 1: CREDITOR LIST -->
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding FilteredCreditors}"
                            SelectionMode="None"
                            Margin="12,0">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Footer>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <Label Text="Walang nahanap na utang."
                           Style="{StaticResource CaptionLabel}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <VerticalStackLayout Spacing="10">

                                <!-- Name + status badge (Unpaid / Partial / Paid) -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding CreditorName}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource PrimaryDark}" />

                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#1AC0392B">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Partial">
                                                <Setter Property="BackgroundColor" Value="#1AE67E22" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Paid">
                                                <Setter Property="BackgroundColor" Value="#1A16A085" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Status}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#C0392B">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Partial">
                                                    <Setter Property="TextColor" Value="#E67E22" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Paid">
                                                    <Setter Property="TextColor" Value="#16A085" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                                <!-- Balance + dates -->
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                         VerticalOptions="Center" Spacing="0">
                                        <Label Text="BALANCE" Style="{StaticResource CaptionLabel}" />
                                        <Label Text="{Binding Balance, StringFormat='₱{0:N2}'}"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="#004D40" />
                                        <Label FontSize="12" Style="{StaticResource CaptionLabel}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding AmountPaid, StringFormat='paid ₱{0:N2}'}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding CreditAmount, StringFormat='of ₱{0:N2}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding CreditDate, StringFormat='Date: {0:MMM dd, yyyy}'}"
                                           FontSize="12"
                                           HorizontalTextAlignment="End"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding DueDate, StringFormat='Due: {0:MMM dd, yyyy}'}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{Binding DueDate, Converter={StaticResource DueDateToColorConverter}}" />
                                </Grid>

                                <ProgressBar Progress="{Binding ProgressFraction}"
                                             ProgressColor="{StaticResource Primary}" />

                                <!-- Paid date, or the Add Payment button -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding PaidDate, StringFormat='Paid on: {0:MMM dd, yyyy}'}"
                                           IsVisible="{Binding IsPaid}"
                                           FontSize="13"
                                           FontAttributes="Italic"
                                           VerticalOptions="Center"
                                           TextColor="#16A085" />

                                    <Button Grid.Column="1"
                                            Text="Add Payment"
                                            Style="{StaticResource FilledButton}"
                                            IsVisible="{Binding IsPaid, Converter={StaticResource InverseBoolConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=TogglePayPanelCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <!-- Add-payment panel -->
                                <Border IsVisible="{Binding IsPayPanelOpen}"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                        BackgroundColor="{AppThemeBinding Light=#F7F8F9, Dark=#262626}"
                                        StrokeThickness="1"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="PAYMENT AMOUNT (₱)" Style="{StaticResource CaptionLabel}" />
                                        <Entry Text="{Binding PayAmountText}"
                                               Keyboard="Numeric"
                                               Placeholder="Amount"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                        <Entry Text="{Binding PayNote}"
                                               Placeholder="Note (optional)"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Grid.Column="0"
                                                    Text="Cancel"
                                                    Style="{StaticResource OutlineButton}"
                                                    BorderColor="{StaticResource PrimaryDark}"
                                                    TextColor="{StaticResource PrimaryDark}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=TogglePayPanelCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1"
                                                    Text="Save Payment"
                                                    Style="{StaticResource FilledButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=SavePaymentCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1"
                                         Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" />

                                <!-- Payment history -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPayments}">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                        <Label Grid.Column="0"
                                               Text="{Binding PaymentsHeader}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IsHistoryExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                               FontSize="20"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource PrimaryDark}" />

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=ToggleHistoryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <VerticalStackLayout Spacing="10"
                                                         IsVisible="{Binding IsHistoryExpanded}"
                                                         BindableLayout.ItemsSource="{Binding Payments}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                        <Label FontSize="14" FontAttributes="Bold" TextColor="#004D40">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding Amount, StringFormat='₱{0:N2}'}" />
                                                                    <Span Text="  ·  " />
                                                                    <Span Text="{Binding DatePaid, StringFormat='{0:MMM dd, yyyy}'}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsVoided}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label Text="{Binding Note}"
                                                               IsVisible="{Binding HasNote}"
                                                               Style="{StaticResource CaptionLabel}"
                                                               FontSize="12" />
                                                    </VerticalStackLayout>

                                                    <Button Grid.Column="1"
                                                            Text="Void"
                                                            Style="{StaticResource SmallOutlineButton}"
                                                            BorderColor="{StaticResource CancelButton}"
                                                            TextColor="{StaticResource CancelButton}"
                                                            IsVisible="{Binding CanVoid}"
                                                            VerticalOptions="Center"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=VoidPaymentCommand}"
                                                            CommandParameter="{Binding .}" />

                                                    <Label Grid.Column="1"
                                                           Text="VOIDED"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#C0392B"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding IsVoided}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Collapsible notes (free text, saved automatically) -->
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                        <Label Grid.Column="0"
                                               Text="Notes"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IsNotesExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                               FontSize="20"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource PrimaryDark}" />

                                        <!-- Whole row is the tap target -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=ToggleNotesCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <Border IsVisible="{Binding IsNotesExpanded}"
                                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                            BackgroundColor="{AppThemeBinding Light=#F7F8F9, Dark=#262626}"
                                            StrokeThickness="1"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="10">
                                            <Editor Text="{Binding Notes}"
                                                    AutoSize="TextChanges"
                                                    MinimumHeightRequest="90"
                                                    BackgroundColor="Transparent"
                                                    Placeholder="Type notes..."
                                                    TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />

                                            <Button Text="Clear Notes"
                                                    Style="{StaticResource OutlineButton}"
                                                    HeightRequest="38"
                                                    HorizontalOptions="End"
                                                    BorderColor="{StaticResource PrimaryDark}"
                                                    TextColor="{StaticResource PrimaryDark}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=ClearNotesCommand}"
                                                    CommandParameter="{Binding}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Color="{StaticResource PrimaryDark}" />
        </Grid>
    </Grid>
</ContentPage>
