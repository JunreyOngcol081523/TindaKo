<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TindaKo.Views.CreditorPage"
    xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
    xmlns:converters="clr-namespace:TindaKo.Converters"
    xmlns:segmentedControl="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"

    Title="Listahan ng Utang"
    BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <ContentPage.BindingContext>
        <viewmodel:CreditorViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#757575, Dark=#A0A0A0}" />
            </Style>

            <Style x:Key="FilledButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="18,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Rows: filters + totals | creditor list (fills space) -->
    <Grid RowDefinitions="Auto,*" RowSpacing="8">

        <!-- ROW 0: FILTER, TOTAL, SEARCH -->
        <VerticalStackLayout Grid.Row="0" Padding="12,12,12,0" Spacing="10">

            <segmentedControl:SfSegmentedControl
                ItemsSource="{Binding SegmentOptions}"
                SelectedIndex="{Binding SelectedSegmentIndex, Mode=TwoWay}"
                SegmentHeight="42" />

            <!-- Total amount banner -->
            <Border BackgroundColor="{StaticResource PrimaryDark}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Total Amount"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{StaticResource WhiteText}" />
                    <Label Grid.Column="1"
                           Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource WhiteText}" />
                </Grid>
            </Border>

            <SearchBar Placeholder="Search creditor..."
                       Text="{Binding SearchText}" />
        </VerticalStackLayout>

        <!-- ROW 1: CREDITOR LIST -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredCreditors}"
                        SelectionMode="None"
                        Margin="12,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.Footer>
                <BoxView HeightRequest="12" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <Label Text="Walang nahanap na utang."
                       Style="{StaticResource CaptionLabel}"
                       FontSize="13"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <VerticalStackLayout Spacing="10">

                            <!-- Name + status badge -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding CreditorName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource PrimaryDark}" />

                                <Border Grid.Column="1"
                                        Padding="10,4"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#1AC0392B">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsPaid}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="#1A16A085" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding IsPaid, Converter={StaticResource BoolToStatusConverter}}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#C0392B">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsPaid}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="#16A085" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>

                            <!-- Amount + dates -->
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                       Text="{Binding CreditAmount, StringFormat='₱{0:N2}'}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="#004D40" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CreditDate, StringFormat='Date: {0:MMM dd, yyyy}'}"
                                       FontSize="12"
                                       HorizontalTextAlignment="End"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding DueDate, StringFormat='Due: {0:MMM dd, yyyy}'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{Binding DueDate, Converter={StaticResource DueDateToColorConverter}}" />
                            </Grid>

                            <!-- Paid date + action -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding PaidDate, StringFormat='Paid on: {0:MMM dd, yyyy}'}"
                                       IsVisible="{Binding IsPaid}"
                                       FontSize="13"
                                       FontAttributes="Italic"
                                       VerticalOptions="Center"
                                       TextColor="#16A085" />

                                <Button Grid.Column="1"
                                        Text="Mark as Paid"
                                        Style="{StaticResource FilledButton}"
                                        IsVisible="{Binding IsPaid, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=MarkAsPaidCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="Mark as Unpaid"
                                        Style="{StaticResource OutlineButton}"
                                        BorderColor="{StaticResource CancelButton}"
                                        TextColor="{StaticResource CancelButton}"
                                        IsVisible="{Binding IsPaid}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=MarkAsUnpaidCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" />

                            <!-- Collapsible notes -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                    <Label Grid.Column="0"
                                           Text="Notes"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding IsNotesExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource PrimaryDark}" />

                                    <!-- Whole row is the tap target -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=ToggleNotesCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <Border IsVisible="{Binding IsNotesExpanded}"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                        BackgroundColor="{AppThemeBinding Light=#F7F8F9, Dark=#262626}"
                                        StrokeThickness="1"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="10">
                                        <Editor Text="{Binding Notes}"
                                                AutoSize="TextChanges"
                                                MinimumHeightRequest="90"
                                                BackgroundColor="Transparent"
                                                Placeholder="Type notes..."
                                                TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />

                                        <Button Text="Clear Notes"
                                                Style="{StaticResource OutlineButton}"
                                                HeightRequest="38"
                                                HorizontalOptions="End"
                                                BorderColor="{StaticResource PrimaryDark}"
                                                TextColor="{StaticResource PrimaryDark}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreditorViewModel}}, Path=ClearNotesCommand}"
                                                CommandParameter="{Binding}" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>