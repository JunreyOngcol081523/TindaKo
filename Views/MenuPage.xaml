<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             x:Class="TindaKo.Views.MenuPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             Title="TindaKo App">

    <ContentPage.Resources>
        <!-- Shared label style for the menu tiles -->
        <Style x:Key="TileLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
    </ContentPage.Resources>

    <!-- Row 0: scrolling content | Row 1: fixed bottom area (ad banner) -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="12" Spacing="14">

                <!-- ========== 1. HEADER ========== -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10">
                        <Image Source="person.png" HeightRequest="36" />
                        <Label Text="{Binding UserName, StringFormat='Welcome {0}'}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray500}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="14">
                        <Image Source="info.png" HeightRequest="32" />
                        <Image Source="logout.png" HeightRequest="32">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </HorizontalStackLayout>
                </Grid>

                <!-- ========== 2. ALERTS (Due Utang / Low Stock) ========== -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                    <!-- Due Utang -->
                    <Border Grid.Column="0"
                            Stroke="{StaticResource Gray200}"
                            StrokeThickness="1"
                            Padding="12,8"
                            StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="calendar.png" HeightRequest="32" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding DueUnpaidCredits}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource CancelButton}" />
                                <Label Text="Due Utang"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateUnpaidDueCreditsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Low Stocks -->
                    <Border Grid.Column="1"
                            Stroke="{StaticResource Gray200}"
                            StrokeThickness="1"
                            Padding="12,8"
                            StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="low.png" HeightRequest="32" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding LowStocksCount}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource CancelButton}" />
                                <Label Text="Low Stock"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateLowStockProductsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- ========== 3. SALES CARD ========== -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="10"
                          RowSpacing="14">

                        <!-- Daily (hero) -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="Daily Sales"
                                   FontAttributes="Italic"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="{Binding DailySales, StringFormat='₱{0:N2}'}"
                                   TextColor="{StaticResource Gray950}"
                                   FontSize="28"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Monthly -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="Monthly Sales"
                                   FontAttributes="Italic"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="{Binding MonthlySales, StringFormat='₱{0:N2}'}"
                                   TextColor="{StaticResource Gray950}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   Margin="0,6,0,0" />
                        </VerticalStackLayout>

                        <!-- Mag Benta: main action, full width -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2"
                                Style="{StaticResource MenuCard}"
                                BackgroundColor="{StaticResource Primary}"
                                HeightRequest="60">
                            <HorizontalStackLayout Spacing="10"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Image Source="shoppingbasketwhite.png" HeightRequest="36" />
                                <Label Text="Mag Benta"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource WhiteText}" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateSellCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- View Sales: secondary (outlined) -->
                        <Border Grid.Row="2" Grid.ColumnSpan="2"
                                Style="{StaticResource MenuCard}"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1.5"
                                HeightRequest="55">
                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Image Source="pesowhite.png" HeightRequest="24" />
                                <Label Text="View Sales"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateSalesCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========== 4. MENU TILES ========== -->
                <!-- Row 0 starts with the tile every role can use (Utang) -->
                <Grid RowDefinitions="100,100"
                      ColumnDefinitions="*,*,*"
                      RowSpacing="10"
                      ColumnSpacing="10">

                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource MenuCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCreditsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="notebook.png" HeightRequest="32" />
                            <Label Text="Listahan ng Utang" Style="{StaticResource TileLabel}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource MenuCard}"
                            IsEnabled="{Binding IsAdmin}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProductCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="product.png" HeightRequest="32" />
                            <Label Text="Products" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource MenuCard}"
                            IsEnabled="{Binding IsAdmin}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateIncomingStocksCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="inventory.png" HeightRequest="32" />
                            <Label Text="Incoming Stocks" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource MenuCard}"
                            IsEnabled="{Binding IsAdmin}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateReportsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="reports.png" HeightRequest="32" />
                            <Label Text="Reports" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource MenuCard}"
                            IsEnabled="{Binding IsAdmin}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="settings.png" HeightRequest="32" />
                            <Label Text="Settings" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource MenuCard}"
                            IsEnabled="{Binding IsAdmin}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateDatabaseCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Image Source="database.png" HeightRequest="32" />
                            <Label Text="Backup" Style="{StaticResource TileLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ========== 5. BOTTOM AD BANNER SLOT (fixed, not scrolling) ========== -->
        <!-- If your ad is already placed elsewhere (e.g. AppShell), delete this Grid. -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource Primary}"
              HeightRequest="50" />
    </Grid>
</ContentPage>
