<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             x:Class="TindaKo.Views.MenuPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             Title="TindaKo App">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,*" 
          Padding="10"
          RowSpacing="5">
            <!--user top-->
            <Grid Grid.Row="0" 
              ColumnDefinitions="Auto,*">

                <Grid Grid.Column="0" HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="person.png" HeightRequest="40"/>
                        <Label Text="{Binding UserName, StringFormat='Welcome {0}'}" 
                           VerticalOptions="Center"
                           TextColor="{StaticResource Gray500}"/>
                    </HorizontalStackLayout>
                </Grid>
                <Grid Grid.Column="1" HorizontalOptions="End">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                        <Image Source="info.png" HeightRequest="40">

                        </Image>
                        <Image Source="logout.png" HeightRequest="40">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer 
                            Command="{Binding LogoutCommand}" 
                            CommandParameter="{Binding .}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
            <!--badges-->
            <Grid Grid.Row="1"
              >
                <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center">
                    <!--due credits-->
                    <Grid>
                        <!-- The main button -->
                        <Button
                            ImageSource="calendar.png"
                            WidthRequest="80"
                            FontSize="8"
                            HeightRequest="60"
                            BackgroundColor="Transparent"
                            Command="{Binding NavigateUnpaidDueCreditsCommand}"/>

                                    <!-- The badge (using Border instead of Frame) -->
                            <Border
                                BackgroundColor="{StaticResource CancelButton}"
                                StrokeThickness="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="5"
                                WidthRequest="20"
                                HeightRequest="20"
                                StrokeShape="RoundRectangle 10,10,10,10">

                                <Label
                                    Text="{Binding DueUnpaidCredits}"
                                    FontSize="12"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>
                            </Border>
                    </Grid>
                   <!--low stocks-->  
                    <Grid>
                        <!-- The main button -->
                        <Button
                            ImageSource="low.png"
                            BackgroundColor="Transparent"
                            WidthRequest="80"
                            HeightRequest="60"
                            Command="{Binding NavigateLowStockProductsCommand}"
                            />

                                    <!-- The badge (using Border instead of Frame) -->
                            <Border
                            BackgroundColor="{StaticResource CancelButton}"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="5"
                            WidthRequest="20"
                            HeightRequest="20"
                            StrokeShape="RoundRectangle 10,10,10,10">

                                <Label
                                Text="{Binding LowStocksCount}"
                                FontSize="12"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>
                            </Border>
                    </Grid>
                    <!--fast moving products-->
                    <Grid>
                        <!-- The main button -->
                        <Button
                            ImageSource="fastmoving.png"
                            WidthRequest="80"
                            HeightRequest="80"
                            BackgroundColor="Transparent"
                            FontSize="10"
                            Command="{Binding NavigateFastSellingProductsCommand}"
                       />

                                    <!-- The badge (using Border instead of Frame) -->
                            <Border
                                BackgroundColor="{StaticResource CancelButton}"
                                StrokeThickness="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="5"
                                WidthRequest="20"
                                HeightRequest="20"
                                StrokeShape="RoundRectangle 10,10,10,10">

                                <Label
                                    Text="{Binding FastMovingProductsCount}"
                                    FontSize="12"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>
                            </Border>
                    </Grid>

                </HorizontalStackLayout>
            </Grid>
            <!--card daily sales-->
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10"
                      RowSpacing="30">
                        <!--#region daily -->
                        <VerticalStackLayout  Grid.Row="0" Grid.Column="0">
                            <Label Grid.Row="1"
                               Text="Daily Sales"
                               FontAttributes="Italic"
                               TextColor="{StaticResource PrimaryDark}"/>
                            <Label
                               Text="{Binding DailySales, StringFormat='₱{0:N2}'}"
                               TextColor="{StaticResource Gray950}"
                               FontSize="25"
                               FontAttributes="Bold"/>

                        </VerticalStackLayout>
                        <!--#endregion-->
                        <!--#region benta -->
                        <VerticalStackLayout  
                            Grid.Row="1" 
                            Grid.Column="0">
                            <Border Style="{StaticResource MenuCard}" BackgroundColor="{StaticResource Primary}">
                                <HorizontalStackLayout Spacing="5">
                                    <Image Source="shoppingbasketwhite.png" HeightRequest="40"/>
                                    <Label Text="Mag Benta" 
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource WhiteText}"/>
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateSellCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>
                        <!--#endregion-->
                        <!--#region monthly -->
                        <VerticalStackLayout  Grid.Row="0" Grid.Column="1">
                            <Label Grid.Row="1"
                            Text="Monthly Sales"
                            FontAttributes="Italic"
                            TextColor="{StaticResource PrimaryDark}"/>
                            <Label
                           Text="{Binding MonthlySales, StringFormat='₱{0:N2}'}"
                           TextColor="{StaticResource Gray950}"
                           FontSize="20"
                           FontAttributes="Bold"/>

                        </VerticalStackLayout>
                        <!--#endregion-->
                        <!--#region sales -->
                        <VerticalStackLayout  Grid.Row="1" Grid.Column="1">
                            <Border Style="{StaticResource MenuCard}" BackgroundColor="{StaticResource Primary}">
                                <HorizontalStackLayout Spacing="5">
                                    <Image Source="pesowhite.png" HeightRequest="40"/>
                                    <Label Text="View Sales" 
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource WhiteText}"/>
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateSalesCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>
                        <!--#endregion-->
                    </Grid>

                </Border>
            </Grid>
            <!--monthly profit due-->
            <Grid Grid.Row="3"
              BackgroundColor="Transparent">
                <BoxView HeightRequest="60"/>
            </Grid>
            <!--menu-->
            <Grid Grid.Row="4"
                  Padding="10"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*,*"
              RowSpacing="10"
              ColumnSpacing="10">
                <!--#region row 0 -->

                <Border Grid.Row="0" 
                    Grid.Column="0"
                    Style="{StaticResource MenuCard}"
                    IsEnabled="{Binding IsAdmin}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateProductCommand}" />
                    </Border.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center">
                        <Image Source="product.png" HeightRequest="30"/>
                        <Label Text="Products" 
                           HorizontalTextAlignment="Center"
                               FontSize="10"/>
                    </StackLayout>

                </Border>

                <Border Grid.Row="0" 
                    Grid.Column="1"
                    IsEnabled="{Binding IsAdmin}"
                    Style="{StaticResource MenuCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateIncomingStocksCommand}" />
                    </Border.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center">
                        <Image Source="inventory.png" HeightRequest="30"/>
                        <Label Text="Incoming Stocks" 
                           HorizontalTextAlignment="Center"
                           FontSize="10"/>
                    </StackLayout>
                </Border>

                <Border Grid.Row="1" 
                    Grid.Column="0"
                    IsEnabled="{Binding IsAdmin}"
                    Style="{StaticResource MenuCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateReportsCommand}" />
                    </Border.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center">
                        <Image Source="reports.png" HeightRequest="30"/>
                        <Label Text="Reports" 
                               HorizontalTextAlignment="Center"
                               FontSize="10"/>
                    </StackLayout>
                </Border>
                <Border Grid.Row="1" 
                    Grid.Column="1"
                    IsEnabled="{Binding IsAdmin}"
                    Style="{StaticResource MenuCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center">
                        <Image Source="settings.png" HeightRequest="30"/>
                        <Label Text="Settings" 
                               HorizontalTextAlignment="Center"
                               FontSize="10"/>
                    </StackLayout>
                </Border>
                <Border Grid.Row="0" 
                    Grid.Column="2"
                    Style="{StaticResource MenuCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateCreditsCommand}" />
                    </Border.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center">
                        <Image Source="notebook.png" HeightRequest="30"/>
                        <Label Text="Listahan ng Utang" 
                           HorizontalTextAlignment="Center"
                           FontSize="10"/>
                    </StackLayout>
                </Border>
                <Border Grid.Row="1" 
                    Grid.Column="2"
                    Style="{StaticResource MenuCard}"
                    IsEnabled="{Binding IsAdmin}">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateDatabaseCommand}" />
                    </Border.GestureRecognizers>
                    <StackLayout HorizontalOptions="Center">
                        <Image Source="database.png" HeightRequest="30"/>
                        <Label Text="DB Backup/Restore" 
                           HorizontalTextAlignment="Center"
                           FontSize="10"/>
                    </StackLayout>
                </Border>
  

            </Grid>
            <!--ads banner-->
            <Grid Grid.Row="5">
                
            </Grid>

            <!--footer-->
            <Grid Grid.Row="6"
              BackgroundColor="{StaticResource Primary}">

            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>