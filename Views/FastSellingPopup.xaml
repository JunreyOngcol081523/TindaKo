<?xml version="1.0" encoding="utf-8" ?>
<sfPopup:SfPopup  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Toolkit.Popup;assembly=Syncfusion.Maui.Toolkit"
    xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
    xmlns:model="clr-namespace:TindaKo.Models"  
    x:Class="TindaKo.Views.FastSellingPopup"
    x:Name="FastSellingSfPopup"
    AutoSizeMode="Height"
    ShowCloseButton="True">

    <!-- Header -->
    <sfPopup:SfPopup.HeaderTemplate>
        <DataTemplate>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Image Source="fastmoving.png" HeightRequest="40"/>
                <Label Text="Top Fast Selling Products" 
                       TextColor="{StaticResource PrimaryDark}"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </HorizontalStackLayout>
        </DataTemplate>
    </sfPopup:SfPopup.HeaderTemplate>

    <!-- Content -->
    <sfPopup:SfPopup.ContentTemplate>
        <DataTemplate>
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="10">

                    <!-- Table Header -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,5">
                        <Label Text="Product"
                               FontAttributes="Bold"
                               TextColor="Black"/>
                        <Label Text="Sold Qty"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalOptions="End"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="Gray" />

                    <!-- Table Rows -->
                    <CollectionView ItemsSource="{Binding FastSellingProducts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                    <!-- Product Name -->
                                    <Label Text="{Binding ProductName}"
                           VerticalOptions="Center"/>

                                    <!-- Quantity -->
                                    <Label Text="{Binding TotalQty}"
                                           Grid.Column="1"
                                           TextColor="Gray"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button ImageSource="share.png" 
                            HeightRequest="30" 
                            BackgroundColor="Transparent"
                            Command="{Binding ShareFastSellingProductsCommand}"/>
                </VerticalStackLayout>

            </ScrollView>
        </DataTemplate>
    </sfPopup:SfPopup.ContentTemplate>
</sfPopup:SfPopup>
