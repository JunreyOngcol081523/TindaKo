<?xml version="1.0" encoding="utf-8" ?>
<sfPopup:SfPopup  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Toolkit.Popup;assembly=Syncfusion.Maui.Toolkit"
    xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
    xmlns:model="clr-namespace:TindaKo.Models"  
    x:Class="TindaKo.Views.LowStockPopup"
    x:Name="LowStockSfPopup"
    AutoSizeMode="Height"
    ShowCloseButton="True">

    <!-- Header -->
    <sfPopup:SfPopup.HeaderTemplate>
        <DataTemplate>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Image Source="warning.png" HeightRequest="40"/>
                <Label Text="⚠ Low Stock Products" 
                       TextColor="{StaticResource PrimaryDark}"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </HorizontalStackLayout>
        </DataTemplate>
    </sfPopup:SfPopup.HeaderTemplate>

    <!-- Content -->
    <sfPopup:SfPopup.ContentTemplate>
        <DataTemplate>
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="10">

                    <!-- Table Header -->
                    <Grid ColumnDefinitions="*,*,Auto" Padding="0,0,0,5">
                        <Label Text="Product"
           FontAttributes="Bold"
           TextColor="Black"/>
                        <Label Text="Category"
           Grid.Column="1"
           FontAttributes="Bold"
           TextColor="Black"/>
                        <Label Text="Remaining"
           Grid.Column="2"
           FontAttributes="Bold"
           TextColor="Black"
           HorizontalOptions="End"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="Gray" />

                    <!-- Table Rows -->
                    <CollectionView ItemsSource="{Binding LowStockProducts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto" Padding="0,5">
                                    <!-- Product Name -->
                                    <Label Text="{Binding ProdName}"
                       VerticalOptions="Center"/>

                                    <!-- Category Name -->
                                    <Label Text="{Binding Category}"
                       Grid.Column="1"
                       VerticalOptions="Center"/>

                                    <!-- Remaining Stock -->
                                    <Label Text="{Binding CurrentStock}"
                       Grid.Column="2"
                       TextColor="Red"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                    <!-- Share Button -->
                    <Button ImageSource="share.png" 
                            HeightRequest="30" 
                            BackgroundColor="Transparent"
                            Command="{Binding ShareLowStockProductsCommand}"/>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </sfPopup:SfPopup.ContentTemplate>
</sfPopup:SfPopup>
