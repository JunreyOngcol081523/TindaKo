<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TindaKo.Views.DatabaseBackupPage"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             Title="TindaKo Database Backup">
    <VerticalStackLayout>
        <Grid Margin="20"
                    RowDefinitions="*,*,*"
                    ColumnDefinitions="*,*" 
                    ColumnSpacing="16" 
                    RowSpacing="16">
            <Border Grid.Row="0" Grid.Column="0"  
                        Style="{StaticResource CardStyle}"
                        >
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackupCommand}" />
                </Border.GestureRecognizers>
                <StackLayout HorizontalOptions="Center">
                    <Image Source="backup.png" HeightRequest="40"/>
                    <Label Text="Backup Database" HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Border>


            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoadBackupFilesCommand}" />
                </Border.GestureRecognizers>
                <StackLayout HorizontalOptions="Center">
                    <Image Source="product.png" HeightRequest="40"/>
                    <Label Text="Show Backup Files" HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Border>
            <Grid Grid.Row="1" 
                  Grid.Column="0" 
                  Grid.ColumnSpan="2"
                  RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10">
                    <Label FontAttributes="Bold" Grid.Column="0" Text="Filename"/>
                    <Label FontAttributes="Bold" Grid.Column="1" Text="Restore | Delete | Email | Share" HorizontalOptions="End" HorizontalTextAlignment="End"/>
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding BackupFiles}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                                <Label Text="{Binding FileName}" 
                                       VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                    <Button ImageSource="restore.png"
                                            BackgroundColor="Transparent"
                                            HeightRequest="30"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DBViewModel}}, Path=RestoreBackupCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsMainDatabase, Converter={StaticResource InverseBoolConverter}}" />

                                    <Button ImageSource="delete.png"
                                            HeightRequest="30"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DBViewModel}}, Path=DeleteBackupCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsMainDatabase, Converter={StaticResource InverseBoolConverter}}" />

                                    <Button ImageSource="mail.png"
                                            BackgroundColor="Transparent"
                                            HeightRequest="30"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DBViewModel}}, Path=EmailBackupCommand}"
                                            IsEnabled="{Binding IsMainDatabase, Converter={StaticResource InverseBoolConverter}}" 
                                            CommandParameter="{Binding .}" />

                                    <Button ImageSource="share.png"
                                            BackgroundColor="Transparent"
                                            HeightRequest="30"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DBViewModel}}, Path=ShareBackupCommand}"
                                            IsEnabled="{Binding IsMainDatabase, Converter={StaticResource InverseBoolConverter}}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
            <Grid Grid.Row="2">
                <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="40"/>
            </Grid>

        </Grid>
    </VerticalStackLayout>
</ContentPage>