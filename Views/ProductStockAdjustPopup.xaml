<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Toolkit.NumericUpDown;assembly=Syncfusion.Maui.Toolkit"
    x:Class="TindaKo.Views.ProductStockAdjustPopup">

    <VerticalStackLayout Padding="20" Spacing="10">
        
        <Label Text="{Binding _product.ProdName, StringFormat='Product: {0}'}"
               FontSize="16" FontAttributes="Bold"/>

        <Label Text="Add Stocks In:" />
        <editors:SfNumericUpDown
                                            Value="{Binding NewStocksIn}"
                                            AllowNull="False"
                                            UpDownButtonColor="{StaticResource PrimaryDark}"
                                            Minimum="0"
                                            CustomFormat="0"
                                            UpDownButtonAlignment="Both" 
                                            SmallChange="1"/>
        <Label Text="Add Stocks Out:" />
        <editors:SfNumericUpDown
                                            Value="{Binding NewStocksOut}"
                                            AllowNull="False"
                                            UpDownButtonColor="{StaticResource PrimaryDark}"
                                            Minimum="0"
                                            CustomFormat="0"
                                            UpDownButtonAlignment="Both" 
                                            SmallChange="1"/>
        <Label Text="{Binding ReadMe}" FontAttributes="Italic" TextColor="{StaticResource Gray400}"/>
        <Button Text="Confirm Adjust" 
                Command="{Binding AdjustProductStocksCommand}" />

        <Button Text="Cancel Adjusting Stocks" Command="{Binding CloseAdjustCommand}" BackgroundColor="{StaticResource CancelButton}"/>
    </VerticalStackLayout>
</ContentPage>
