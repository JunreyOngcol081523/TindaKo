<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TindaKo.ViewModel"
             x:Class="TindaKo.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Welcome & App Info -->
            <Label Text="Welcome to TindaKo!" 
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="TindaKo helps you manage sales, track inventory, and view reports like fast-moving products — all offline!"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="Developed by JunreyDev"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <!-- User Role Selection -->
            <Label Text="Pumili ng Role:" FontSize="16" />
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalOptions="Center">
                <RadioButton Grid.Column="0" Content="May-ari" 
                     GroupName="UserRole"
                     IsChecked="{Binding SelectedRole, Converter={StaticResource StringEqualsConverter}, ConverterParameter=May-ari}" />
                <RadioButton Grid.Column="1" Content="Tindera" 
                     GroupName="UserRole"
                     IsChecked="{Binding SelectedRole, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Tindera}" />
            </Grid>

            <!-- Username -->
            <Entry Text="{Binding UserName}"
                   Placeholder="Username"
                   Keyboard="Default" />

            <!-- Password -->
            <Entry Text="{Binding UserPassword}"
                   Placeholder="Password"
                   IsPassword="True" />

            <!-- Login Button -->
            <Button Text="Login"
                    CornerRadius="8"
                    Command="{Binding LoginCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
