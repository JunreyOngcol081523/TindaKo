<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TindaKo"
             xmlns:converters="clr-namespace:TindaKo.Converters"
             x:Class="TindaKo.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CardStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- Global NavigationPage App Bar Styling -->
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="BarTextColor" Value="White" />
            </Style>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <converters:DueDateToColorConverter x:Key="DueDateToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
